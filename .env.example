# Discord Webhook Configuration
# ADVERTENCIA: Este archivo contiene una URL sensible que será compilada en el binario
# No commits este archivo .env a git - usa .env.example como plantilla

# Obtener webhook desde: Discord → Servidor → Canal → Editar → Integraciones → Webhooks
# Copiar la URL completa del webhook
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN"
